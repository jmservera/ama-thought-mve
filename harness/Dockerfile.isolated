FROM python:3.12.16-alpine3.24@sha256:e6dae589c1c05976188fd3bd019afd091445fc533ed2ea29001beddc7368a9c8 AS expat
RUN apk upgrade --no-cache \
 && apk add --no-cache alpine-sdk bash patch \
 && apk update \
 && adduser -D builder \
 && addgroup builder abuild \
 && mkdir -p /build/hardening /packages /var/cache/distfiles \
 && chown -R builder:builder /build /packages /var/cache/distfiles
COPY --chown=builder:builder security/alpine/expat /build/hardening/expat
ENV REPODEST=/packages JOBS=2 MAKEFLAGS=-j2
USER builder
WORKDIR /build/hardening/expat
RUN abuild-keygen -an && abuild fetch
USER root
RUN install -m 644 /home/builder/.abuild/*.rsa.pub /etc/apk/keys/
USER builder
RUN --network=none abuild -r

FROM expat AS python_xml
USER root
RUN apk add --no-cache xz \
 && apk update \
 && apk add --no-network \
	/packages/hardening/x86_64/expat-2.9.0-r100.apk \
	/packages/hardening/x86_64/libexpat-2.9.0-r100.apk \
	/packages/hardening/x86_64/expat-dev-2.9.0-r100.apk
COPY --chown=builder:builder security/alpine/python-xml /build/hardening/mve-python-xml
USER builder
WORKDIR /build/hardening/mve-python-xml
RUN abuild fetch
RUN --network=none abuild -r

FROM python:3.12.16-alpine3.24@sha256:e6dae589c1c05976188fd3bd019afd091445fc533ed2ea29001beddc7368a9c8 AS busybox
RUN apk upgrade --no-cache \
 && apk add --no-cache alpine-sdk bash patch perl linux-headers openssl-dev utmps-dev utmps-static zip \
 && apk update \
 && adduser -D builder \
 && addgroup builder abuild \
 && mkdir -p /build/hardening /packages /var/cache/distfiles /evidence \
 && chown -R builder:builder /build /packages /var/cache/distfiles /evidence
COPY --chown=builder:builder security/alpine/busybox-aports.tar.gz /build/
COPY --chown=builder:builder security/alpine/prepare-busybox.py security/alpine/verify-busybox.py security/alpine/busybox-date-utc.patch.gz /build/tools/
ENV REPODEST=/packages JOBS=2 MAKEFLAGS=-j2
USER builder
WORKDIR /build
RUN echo '0998037cf5c752fff144b075629df0f3d00fdbcc5a425aa17f63b057abc4b8a2  busybox-aports.tar.gz' | sha256sum -c - \
 && tar -xzf busybox-aports.tar.gz --strip-components=1 -C /build/hardening main/busybox \
 && gzip -dc /build/tools/busybox-date-utc.patch.gz > /build/hardening/busybox/mve-date-utc.txt \
 && python3 /build/tools/prepare-busybox.py /build/hardening/busybox
WORKDIR /build/hardening/busybox
RUN abuild-keygen -an && abuild fetch
USER root
RUN install -m 644 /home/builder/.abuild/*.rsa.pub /etc/apk/keys/
USER builder
# The unchanged vendor source checks include public-network wget tests.
RUN abuild -r

FROM node:24.22.2-alpine3.24@sha256:8a32c8cf649a49915a66e81e7a609223c708d0adabf288ee3f4077d765542f85 AS metrics
RUN npm install --global jscpd@5.4.1 && npm cache clean --force

FROM python:3.12.16-alpine3.24@sha256:e6dae589c1c05976188fd3bd019afd091445fc533ed2ea29001beddc7368a9c8
RUN apk upgrade --no-cache \
 && apk add --no-cache git make libstdc++
RUN python - <<'PY'
from pathlib import Path
import shutil

origins = {
    line[2:] for line in Path("/lib/apk/db/installed").read_text().splitlines()
    if line.startswith("o:")
}
assert "musl" in origins
assert not origins.intersection(("acl", "perl", "tar", "dash"))
assert all(shutil.which(name) is None for name in ("perl", "infocmp", "ptar", "ptardiff", "ptargrep"))
PY
RUN pip install --no-cache-dir --upgrade pip==26.2.2 \
 && pip install --no-cache-dir ruff==0.17.3 lizard==1.24.3 pytest==9.1.1 pytest-timeout==2.4.0 \
 && python -m pip uninstall -y pip
COPY --from=expat /home/builder/.abuild/*.rsa.pub /etc/apk/keys/
COPY --from=busybox /home/builder/.abuild/*.rsa.pub /etc/apk/keys/
RUN --network=none \
 --mount=type=bind,from=expat,source=/packages/hardening/x86_64,target=/mve-expat \
 --mount=type=bind,from=python_xml,source=/packages/hardening/x86_64,target=/mve-python-xml \
 --mount=type=bind,from=busybox,source=/packages/hardening/x86_64,target=/mve-busybox \
 apk add --no-network \
 /mve-expat/libexpat-2.9.0-r100.apk \
 /mve-python-xml/mve-python-xml-3.12.16-r1.apk \
 /mve-busybox/busybox-1.37.0-r100.apk \
 /mve-busybox/busybox-binsh-1.37.0-r100.apk \
 /mve-busybox/ssl_client-1.37.0-r100.apk
RUN python - <<'PY'
from pathlib import Path
import sysconfig

suffix = sysconfig.get_config_var("EXT_SUFFIX")
for name in ("pyexpat", "_elementtree"):
    original = Path(sysconfig.get_config_var("DESTSHARED")) / f"{name}{suffix}"
    replacement = Path("/usr/lib/mve-python-xml") / original.name
    assert replacement.is_file() and original.is_file() and not original.is_symlink()
    original.unlink()
    original.symlink_to(replacement)
for directory in ("/bin", "/usr/bin", "/usr/local/bin"):
    for name in ("tar", "cpio", "unzip"):
        path = Path(directory) / name
        if path.is_symlink() and path.resolve() == Path("/bin/busybox"):
            path.unlink()
        assert not path.exists(), path
PY
COPY --from=metrics /usr/local/bin/node /usr/local/bin/node
COPY --from=metrics /usr/local/lib/node_modules/jscpd /usr/local/lib/node_modules/jscpd
COPY --from=busybox /evidence/busybox/removal-proof.json /usr/share/mve-security/busybox-removal-proof.json
COPY security/alpine/expat/backport-provenance.json /usr/share/mve-security/expat-backports.json
COPY security/alpine/verify-runtime.py /usr/share/mve-security/verify-runtime.py
RUN --network=none python /usr/share/mve-security/verify-runtime.py > /usr/share/mve-security/runtime-proof.json
RUN ln -s /usr/local/lib/node_modules/jscpd/run-jscpd.js /usr/local/bin/jscpd \
 && mkdir -p /work /runner /suite \
 && chmod 755 /work /runner /suite
COPY isolation_helper.py /opt/isolation_helper.py
RUN chmod 444 /opt/isolation_helper.py
WORKDIR /work
ENV PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["/usr/local/bin/python3", "-I", "/opt/isolation_helper.py"]
