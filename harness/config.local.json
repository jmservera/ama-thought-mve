{
  "comment": "Real runs on a dedicated Linux VM or dev container, agent started directly. Pin the model, the reasoning effort and the CLI version before the pilot; set max_credits after the pilot. The --deny-tool url rule blocks web access from the shell and web-fetch tools (the CLI's own model calls are unaffected); curl, wget and pip are denied as well.",
  "runs_dir": "../runs",
  "features": 10,
  "budgets_seconds": {
    "feature": 1800,
    "post": 900,
    "change_request": 2700
  },
  "on_undelivered": "drop_examples",
  "env": {},
  "agent_values": {
    "model": "PIN-A-MODEL-ID",
    "effort": "medium",
    "max_credits": "270"
  },
  "agent_command": [
    "copilot",
    "-C",
    "{repo}",
    "-p",
    "{prompt}",
    "--model",
    "{model}",
    "--reasoning-effort",
    "{effort}",
    "--allow-tool",
    "write({repo})",
    "--allow-tool",
    "shell(python3)",
    "--allow-tool",
    "shell(make)",
    "--allow-tool",
    "shell(git status)",
    "--allow-tool",
    "shell(git diff)",
    "--deny-tool",
    "shell(git push)",
    "--deny-tool",
    "url",
    "--deny-tool",
    "shell(curl)",
    "--deny-tool",
    "shell(wget)",
    "--deny-tool",
    "shell(pip)",
    "--deny-tool",
    "shell(pip3)",
    "--no-ask-user",
    "--no-custom-instructions",
    "--disable-builtin-mcps",
    "--no-auto-update",
    "--output-format",
    "json",
    "--log-dir",
    "{logdir}",
    "--log-level",
    "info",
    "--share",
    "{transcript}",
    "--usage-output-file",
    "{usage}",
    "--max-ai-credits",
    "{max_credits}"
  ],
  "agent_env": {
    "COPILOT_HOME": "{copilot_home}",
    "COPILOT_AUTO_UPDATE": "false",
    "COPILOT_OTEL_FILE_EXPORTER_PATH": "{stepdir}/otel.jsonl"
  },
  "measure": {
    "test_runner": "pytest",
    "complexity": "lizard",
    "duplication": "jscpd",
    "lint": "ruff"
  },
  "version_commands": {
    "copilot": "copilot version",
    "python": "python3 --version",
    "pytest": "python3 -m pytest --version",
    "lizard": "lizard --version",
    "jscpd": "jscpd --version",
    "ruff": "ruff --version",
    "git": "git --version",
    "os": "uname -a"
  }
}