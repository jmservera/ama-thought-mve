{
  "comment": "Real runs on a dedicated Linux VM or dev container, agent started directly. Pin the model, the reasoning effort and the CLI version before the pilot; set max_credits after the pilot.",
  "runs_dir": "../runs",
  "features": 10,
  "budgets_seconds": {"feature": 1800, "post": 900, "change_request": 2700},
  "on_undelivered": "drop_examples",
  "env": {},
  "agent_values": {"model": "PIN-A-MODEL-ID", "effort": "medium", "max_credits": "300"},
  "agent_command": ["copilot", "-C", "{repo}", "-p", "{prompt}",
                    "--model", "{model}", "--reasoning-effort", "{effort}",
                    "--allow-all-tools", "--deny-tool", "shell(git push)",
                    "--no-ask-user", "--no-custom-instructions", "--disable-builtin-mcps", "--no-auto-update",
                    "--output-format", "json", "--log-dir", "{logdir}", "--log-level", "info",
                    "--share", "{transcript}", "--usage-output-file", "{usage}",
                    "--max-ai-credits", "{max_credits}"],
  "agent_env": {"COPILOT_HOME": "{copilot_home}", "COPILOT_AUTO_UPDATE": "false",
                "COPILOT_OTEL_FILE_EXPORTER_PATH": "{stepdir}/otel.jsonl"},
  "measure": {"test_runner": "pytest", "complexity": "lizard", "duplication": "jscpd", "lint": "ruff"},
  "version_commands": {"copilot": "copilot version", "python": "python3 --version", "pytest": "python3 -m pytest --version",
                       "lizard": "lizard --version", "jscpd": "jscpd --version", "ruff": "ruff --version", "git": "git --version",
                       "os": "uname -a"}
}
