builddir="$srcdir/expat-$pkgver"

prepare() {
	gzip -dc "$srcdir/2480a0520fee623a8f7c3f038ff9fb491105472c-mve-backport.patch.gz" \
		> "$srcdir/2480a0520fee623a8f7c3f038ff9fb491105472c-mve-backport.patch"
	echo "1e61d29691de8598e11e0e20d6f619da98be8a41b6313402f57043892900a5ae31948c8ac81d23ba22a5e5c31e204c443d30d01488d605842e9cb1cec94b8ac2  $srcdir/2480a0520fee623a8f7c3f038ff9fb491105472c-mve-backport.patch" | sha512sum -c -
	for commit in \
		d545081f6a90792208e0d274888a352e2e5d894d \
		da504c0c111086072172431c76867800673fbc34 \
		b34f62d5935495f61ef3d9d40779ca0ca7b432b2 \
		b068d5a0a228029bb4aac50dc3f343971634f25e \
		c30145b28632b31f805d57f9838ba36b8db99367 \
		d8f31e647a4d1eda088e89354f4769b0dad303d3 \
		c8c6d89617e7408235b160d14707de4ca9e40be7 \
		facd124e8dc8f1a0c039dda1c51a87bb3d398353 \
		2480a0520fee623a8f7c3f038ff9fb491105472c-mve-backport
	do
		patch --batch --forward --fuzz=0 -p2 -i "$srcdir/$commit.patch"
	done
}

build() {
	./configure --prefix=/usr --mandir=/usr/share/man --enable-static
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
}

