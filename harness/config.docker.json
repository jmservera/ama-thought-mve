{
  "comment": "Real runs with the agent in a container that sees only the run's repository. Build the image once (see Dockerfile), record its digest and use the same image for every run. The runner and the measurements run on the host.",
  "runs_dir": "../runs",
  "features": 10,
  "budgets_seconds": {"feature": 1800, "post": 900, "change_request": 2700},
  "on_undelivered": "drop_examples",
  "env": {},
  "agent_values": {"model": "PIN-A-MODEL-ID", "effort": "medium", "max_credits": "300", "image": "mve-agent:frozen"},
  "agent_command": ["docker", "run", "--rm", "--user", "{uid}:{gid}",
                    "-v", "{repo}:/work", "-v", "{stepdir}:/step", "-w", "/work",
                    "-e", "COPILOT_GITHUB_TOKEN", "-e", "HOME=/step/home", "-e", "COPILOT_HOME=/step/copilot-home",
                    "-e", "COPILOT_AUTO_UPDATE=false", "-e", "COPILOT_OTEL_FILE_EXPORTER_PATH=/step/otel.jsonl",
                    "{image}",
                    "copilot", "-C", "/work", "-p", "{prompt}",
                    "--model", "{model}", "--reasoning-effort", "{effort}",
                    "--allow-all-tools", "--deny-tool", "shell(git push)",
                    "--no-ask-user", "--no-custom-instructions", "--disable-builtin-mcps", "--no-auto-update",
                    "--output-format", "json", "--log-dir", "/step/logs", "--log-level", "info",
                    "--share", "/step/transcript.md", "--usage-output-file", "/step/usage.json",
                    "--max-ai-credits", "{max_credits}"],
  "agent_env": {},
  "measure": {"test_runner": "pytest", "complexity": "lizard", "duplication": "jscpd", "lint": "ruff"},
  "version_commands": {"image": "docker image inspect --format '{{.Id}}' mve-agent:frozen",
                       "copilot": "docker run --rm mve-agent:frozen copilot version",
                       "python": "python3 --version", "pytest": "python3 -m pytest --version", "lizard": "lizard --version",
                       "jscpd": "jscpd --version", "ruff": "ruff --version", "git": "git --version", "os": "uname -a"}
}
