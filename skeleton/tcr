#!/usr/bin/env bash
set -euo pipefail

log_file=$(mktemp "${TMPDIR:-/tmp}/tcr.XXXXXXXXXX")
trap 'rm -f -- "${log_file}"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

main() {
  local stage="tests" status
  if {
    make -s test &&
      stage="staging" && git add -A &&
      stage="commit" && git commit -q -m "tcr: ${1:-refactor}"
  } > "${log_file}" 2>&1; then
    printf '%s\n' 'TCR: committed'
  else
    status=$?
    printf 'TCR: %s failed (exit %s)\n' "${stage}" "${status}" >&2
    tail -n 20 -- "${log_file}" >&2
    if git reset -q --hard && git clean -qfd -e reports/; then
      printf '%s\n' 'TCR: reverted' >&2
    else
      printf '%s\n' 'TCR: rollback failed; inspect the worktree' >&2
    fi
    return "${status}"
  fi
}

main "$@"
